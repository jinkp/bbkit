{
  "name": "bbkit-cli",
  "version": "0.1.0",
  "description": "A modern open source CLI for Bitbucket Cloud",
  "type": "module",
  "bin": {
    "bbk": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src --ext .ts",
    "release": "semantic-release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "conf": "^13.0.1",
    "keytar": "^7.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^8.57.0",
    "semantic-release": "^24.2.9",
    "tsup": "^8.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  },
  "author": "jinkp",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinkp/bbkit.git"
  },
  "homepage": "https://github.com/jinkp/bbkit",
  "bugs": {
    "url": "https://github.com/jinkp/bbkit/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
